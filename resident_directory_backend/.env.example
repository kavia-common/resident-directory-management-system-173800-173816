# Backend environment variables (example)
# Required:
JWT_SECRET_KEY="change-me"
POSTGRES_URL="postgresql://localhost:5000/myapp"

# Optional:
ACCESS_TOKEN_EXPIRES_MINUTES="1440"
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES="30"

# If true, forgot-password will NOT return a reset token and instead expects email sending.
EMAIL_SENDING_ENABLED="false"
